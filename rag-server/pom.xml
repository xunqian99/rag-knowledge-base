<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      父工程:由 Spring Boot 统一管理所有依赖的版本号,
      所以下面的依赖大多不需要写 <version>,避免版本冲突。

      为什么用 3.5.x 而不是 Initializr 默认给的 4.1.1:
        1. LangChain4j 的主力 starter(1.20.0-beta30)是编译在 Spring Boot 3.5.13 上的,
           Boot 4 的 starter 是另起的一条新分支,资料少、踩坑多。
        2. Boot 4 把 spring-boot-starter-web 改名成了 spring-boot-starter-webmvc,
           网上绝大多数教程、报错解决方案都还是 Boot 3 的写法。
        3. 你是借助 AI 开发,AI 对 Boot 3 的掌握远比 Boot 4 牢靠,能少走很多弯路。
        4. 企业里主流仍是 Boot 3.x,面试时更容易聊到一块去。

      为什么是 3.5.7 而不是 3.5 线最新的 3.5.16:
        本机 Maven 仓库里已经缓存了 3.5.7 的一整套依赖(web / jpa / actuator / test),
        用它第一次编译几乎不用等待;换成 3.5.16 需要重新下载 100MB 以上的依赖。
        补丁版本号对项目功能没有影响,想升级随时改这一行即可。
        (这是一个典型的工程取舍:稳定可用 > 版本最新)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>cn.ragserver</groupId>
    <artifactId>rag-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-server</name>
    <description>RAG 知识库问答系统</description>

    <properties>
        <java.version>17</java.version>
        <!--
          LangChain4j 不在 Spring Boot 的依赖管理范围内,必须自己指定版本。
          集中写成属性,以后升级只改这一行。
        -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <!--
          Tika 不在 Spring Boot 的依赖管理范围内,自己指定版本。

          为什么用 3.2.3 而不是最新的 4.0.0:
          Tika 4.0.0 把 tika-parsers-standard-package 改成纯 pom 聚合包
          (中央仓库里只有 .pom,没有 .jar),依赖坐标的用法变了。
          3.2.3 有完整的 jar、生态成熟、文档和示例最多,API 与 4.x 一致。
          这是「稳定可用优先于版本最新」的又一例。
        -->
        <tika.version>3.2.3</tika.version>

        <!--
          Elasticsearch 客户端版本必须和服务端对齐。

          Spring Boot 3.5.7 默认管理的是 8.18.8,而 docker-compose 里起的是 8.15.0。
          两者混用时踩了坑:客户端 8.18.8 的反序列化模型要求响应里必须有
          unassignedPrimaryShards 字段,而 8.15.0 的响应里没有,
          于是 cluster().health() 直接报 Failed to decode response。

          覆盖掉 Spring Boot 的默认值(elasticsearch-client.version 同时管
          elasticsearch-java 和 elasticsearch-rest-client),两边都钉到 8.15.0。

          【通用原则】客户端库和服务端版本对齐,能省掉一整类"看起来莫名其妙"的报错。
        -->
        <elasticsearch-client.version>8.15.0</elasticsearch-client.version>
    </properties>

    <dependencies>
        <!-- HTTP 接口能力。Boot 3 里叫 starter-web,Boot 4 改名叫 starter-webmvc。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据库访问(JPA / Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Redis 客户端。第 22 项做缓存时会用到。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          Flyway:数据库表结构的版本管理工具。

          为什么需要它:项目要建 document / document_chunk / chat_session / chat_message
          四张表,其中分块表带 vector 类型字段,JPA 的 ddl-auto 不认识这个类型,
          自动建表走不通。所以表结构改由 SQL 脚本管理,由 Flyway 负责按版本执行。

          注意:Flyway 10 以后把各数据库的支持拆成了独立模块,
          只加 flyway-core 会在启动时报「Unsupported Database: PostgreSQL」,
          必须同时加 flyway-database-postgresql。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 健康检查端点 /actuator/health,第 4 项会用到 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动。版本由父工程管理,不用自己写。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 少写 getter/setter/构造器 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          LangChain4j 的 OpenAI 兼容客户端。

          用它不是为了调 OpenAI,而是因为千帆 v2 提供的是 OpenAI 兼容接口 ——
          换个 baseUrl 就能接上,省得自己拼 HTTP 请求、处理重试和异常。

          更重要的是它提供了 EmbeddingModel 这个统一接口:
          以后要从百度换成通义或 OpenAI,业务代码一行都不用改。

          注意:它会传递依赖 jackson 2.22,而 Spring Boot 3.5 管理的是 2.19.x。
          依赖管理里 Spring Boot 的版本优先,实际用的是 2.19.x —— 这是正常的,
          只要 LangChain4j 没用到 2.22 才有的 API 就不会出问题。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!--
          Apache Tika:文件内容提取器。

          为什么需要:pdf / docx / xlsx 的内部结构都不是文本 ——
          docx 和 xlsx 其实是 zip 包(里面是 XML),pdf 是二进制对象流,
          文字可能被拆成绘制指令、还可能是扫描图片。自己写解析器不现实。

          Tika 负责三件事:
            1. 按文件头识别真实格式(不看扩展名,改名成 .pdf 的可执行文件也认得出)
            2. 调度底层解析器:PDF 用 PDFBox,Office 用 POI
            3. 统一输出成纯文本

          代价是依赖体积大 —— tika-parsers-standard-package 会连带拉进
          PDFBox、POI 等几十个库,jar 增大几十 MB。这个代价必须付。
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!--
          Elasticsearch 官方 Java 客户端。

          版本不自己指定 —— Spring Boot 3.5.7 管理的 8.18.8 已经在本地仓库里,
          而且 8.x 的客户端对 8.x 的服务端是兼容的(服务端是 8.15.0)。

          为什么不用 spring-boot-starter-data-elasticsearch:
            1. 它的版本和 Spring Boot 强绑定,自己能控制的余地小
            2. 它是 CRUD 导向的(声明 Repository),而我们需要的是检索能力
            3. 官方客户端更轻,只引入真正用得到的东西
        -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 只在编译期起作用,不需要打进最终的 jar -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              显式声明注解处理器。不写这段的话,某些环境(尤其是 IDEA 里)
              Lombok 会静默失效,报一堆找不到 getter 的编译错误。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
